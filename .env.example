# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API (or Data API). Both are public by design; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL used in email and Google redirect links. Use your production domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do NOT add the service-role key here or anywhere in this app.
